# Copy to .env (cp .env.example .env), fill in, then: chmod 600 .env
# .env is gitignored. Never commit it.

# Optional: Garmin Personal API key for garmin_sync.py.
# Create one at https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=your-key-here

# Optional: keep your data somewhere other than the default app-data folder.
# KAISEN_DATA_DIR=/path/to/a/private/folder

# Optional: use another port if 8000 is taken.
# KAISEN_PORT=8000
